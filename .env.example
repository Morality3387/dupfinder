# ── لازم ──
# توکنِ ربات از @BotFather
BOT_TOKEN=123456:ABC-DEF...
# آیدیِ عددیِ خودتان (مالکِ ربات). اگر خالی بماند، اولین نفری که /start بزند مالک می‌شود.
OWNER_ID=

# ── اختیاری (پیش‌فرض‌ها مناسب‌اند) ──
DB_PATH=/data/dup.db
LANG=fa
LOG_LEVEL=INFO

# حسابِ کاربری برای دیدنِ «کلِ تاریخچهٔ کانال» — می‌توانید از داخلِ ربات هم وارد شوید (🔑)
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# تنظیماتِ تطبیق
HASH_MODE=candidates        # off | candidates | all
MEDIA_KINDS=video           # video | video+doc | all
TH_NAME_RATIO=0.82
TH_NAME_JACCARD=0.60
TH_CAP_RATIO=0.80
TH_CAP_JACCARD=0.60
SIZE_TOL_PCT=0.5
SIZE_TOL_MIN=2048
DUR_TOL_S=2
MIN_SIZE_FOR_MATCH=102400
MAX_FORWARD_PER_GROUP=12
PAGE_SIZE=8

# 📤 «گروهِ چک» (DK-15): مقصدِ ارسالِ تکراری‌ها برای بازبینی — خالی = تعیین‌نشده.
# می‌شود از خودِ ربات هم تعیین کرد: /check · «⚙️ تنظیمات» ← «📤 گروهِ چک»
CHECK_TARGET=
CHECK_ALBUMS=1             # 1 = تکراری‌های هر گروه کنارِ هم (آلبوم) · 0 = تک‌به‌تک

# 💾 پشتیبانِ هش‌ها (DK-16): «ایندکس + هش» هر کانال در یک فایلِ فشرده (در چتِ خودتان) نگه داشته
# می‌شود تا روی اکانتِ تازه بدونِ اسکنِ از صفر برگردد. رمزها (توکن/سشن/api_hash) داخلش نیست.
KEEP_WEBHOOK=0             # 0 = وبهوکِ احتمالیِ قدیمی برداشته شود تا getUpdates کار کند

# 🗄 پشتیبانِ گیتهاب (DK-17): «عکسِ کاملِ» ایندکس/هش/کانال‌ها/تنظیمات در پوشهٔ backup/ مخزن.
#   • پس از هر اسکنی که هشِ تازه بسازد، خودکار همان‌جا آپدیت می‌شود.
#   • اگر دیتابیسِ سرور خالی باشد (اکانتِ تازه/والیومِ نو) در استارت از همان‌جا برمی‌گردد
#     ⇒ دیگر لازم نیست کانال‌ها و تنظیمات را دستی وارد کنید.
#   • فایل با BACKUP_KEY قفل می‌شود (مخزن عمومی است؛ نامِ فایل‌ها/کپشن‌ها نباید عمومی شوند).
GH_BACKUP_REPO=baddarksss/dupfinder   # خالی = خاموش · می‌تواند یک مخزنِ خصوصیِ جدا هم باشد
GH_BACKUP_PATH=backup                 # مسیرِ پوشهٔ پشتیبان داخلِ مخزن
GH_BACKUP_TOKEN=                      # توکنِ گیتهاب (Contents: Read/Write روی همان مخزن)
BACKUP_KEY=                           # رمزِ قفلِ فایلِ پشتیبان (این را جایی امن نگه دارید)
GH_BACKUP_AUTO=1                      # 1 = آپلودِ خودکار پس از اسکنِ دارای هشِ تازه
